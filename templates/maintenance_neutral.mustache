{{!
    @template theme_ismos/maintenance_neutral

    Unbranded maintenance message page, used while the theme's "Neutral maintenance page" setting is on. It
    names no brand and loads nothing from the site (no theme CSS, favicon, JavaScript or footer), so a visitor
    sees a plain notice. Its styles are inline.

    Context variables required for this template:
    * output - The core renderer for the page
    * title - The page title
    * label - The small label above the heading
    * heading - The heading
    * message - The one-line message

    Example context (json):
    {
        "output": {
            "doctype": "<!DOCTYPE html>",
            "htmlattributes": "dir=\"ltr\" lang=\"en\"",
            "main_content": "<h1>Site maintenance</h1>"
        },
        "title": "Site under maintenance",
        "label": "Maintenance",
        "heading": "We'll be back soon.",
        "message": "We are making improvements to the site. Thank you for your patience."
    }
}}
{{{ output.doctype }}}
<html {{{ output.htmlattributes }}}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>{{ title }}</title>
<style>
  html, body { margin: 0; height: 100%; }
  body { display: flex; align-items: center; justify-content: center; background: #fff; color: #222;
         font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
  main { max-width: 560px; padding: 0 24px; }
  .label { font: 600 12px/16px ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; letter-spacing: .14em;
           text-transform: uppercase; color: #666; margin: 0 0 12px; }
  h1 { font-size: 40px; line-height: 1.15; font-weight: 600; margin: 0 0 16px; }
  p { font-size: 18px; line-height: 1.6; margin: 0; color: #444; }
  @media (prefers-color-scheme: dark) { body { background: #111; color: #eee; } .label { color: #aaa; } p { color: #ccc; } }
  @media (max-width: 480px) { h1 { font-size: 30px; } }
</style>
</head>
<body>
<main>
  <p class="label">{{ label }}</p>
  <h1>{{ heading }}</h1>
  <p>{{ message }}</p>
</main>
{{! Core has to print its main content (it is the page's placeholder token); it is not shown or announced. }}
<div hidden>{{{ output.main_content }}}</div>
</body>
</html>
