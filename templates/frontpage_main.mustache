{{!
    @template theme_ismos/frontpage_main

    ISMOS landing page, inside the main landmark: hero with the next cohort, facts, paths, calendar, how it works,
    testimonials and the final band. Everything comes from Moodle (see theme_ismos\local\landing), copy from the theme
    language files. Core's other front page parts (news, enrolled courses, section 1) follow when there are any.

    Context variables required for this template:
    * hero - label, title, titleem, hastitleem, lead, cta, ctaurl, signup, signupurl (null when not offered), hasnext, next
    * facts - value and label
    * paths, haspaths - name, description, hasdescription, courses (name, url), hascourses, url, haslevel, level (on), kicker
    * calendar, hascalendar - day, month, year, name, category, code, hascode, url
    * steps - number ("01"), title, text, and one of form, room, cert for its drawing
    * testimonials, hastestimonials - quote and name
    * final - heading, cta, url
    * hasextra, section1, content - HTML of the other front page parts, empty when there is none

    Example context (json):
    {
        "hero": {
            "label": "Bitcoin and Lightning school",
            "title": "Learn to run your own money,",
            "titleem": "one lesson at a time.",
            "hastitleem": true,
            "lead": "Live classes with teachers who build on Bitcoin.",
            "cta": "See the courses",
            "ctaurl": "/course/index.php",
            "signup": "Create an account",
            "signupurl": "/login/signup.php",
            "hasnext": true,
            "next": {
                "startslabel": "Starts 3 Nov",
                "name": "Bitcoin Privacy Diploma",
                "summary": "How to protect your privacy.",
                "hassummary": true,
                "category": "Bitcoin Dev",
                "enrolled": "28 enrolled",
                "code": "ES",
                "url": "/course/view.php?id=2"
            }
        },
        "facts": [{"value": "180", "label": "students in the school"}],
        "haspaths": true,
        "paths": [{
            "name": "Bitcoin 4 Everyone",
            "description": "Buy, keep and use Bitcoin.",
            "hasdescription": true,
            "courses": [{"name": "Get and use Bitcoin", "url": "/course/view.php?id=3"}],
            "hascourses": true,
            "url": "/course/index.php?categoryid=1",
            "haslevel": true,
            "level": [{"on": true}, {"on": false}, {"on": false}],
            "kicker": "To start"
        }],
        "hascalendar": true,
        "calendar": [{
            "day": "03", "month": "NOV", "year": "2026", "name": "Bitcoin Privacy Diploma", "category": "Bitcoin Dev",
            "code": "ES", "hascode": true, "url": "/course/view.php?id=2"
        }],
        "steps": [{"number": "01", "title": "Create your account", "text": "One minute.", "form": true}],
        "hastestimonials": true,
        "testimonials": [{"quote": "A beautiful experience.", "name": "Joni, from Argentina"}],
        "final": {"heading": "Your first class starts here.", "cta": "Create a free account", "url": "/login/signup.php"}
    }
}}
{{#hero}}
<section class="ismos-hero" aria-labelledby="ismos-hero-title">
    <svg class="ismos-hero__mark" aria-hidden="true" focusable="false" viewBox="0 0 600 600" fill="currentColor"><polygon points="426.7 431.22 426.7 571.5 309.05 447.51 345.25 349.77 426.7 431.22"></polygon><polygon points="173.3 431.22 173.3 571.5 290.95 447.51 254.75 349.77 173.3 431.22"></polygon><polygon points="426.7 168.77 426.7 28.5 309.05 152.48 345.25 250.22 426.7 168.77"></polygon><polygon points="173.3 168.77 173.3 28.5 290.95 152.48 254.75 250.22 173.3 168.77"></polygon><polygon points="431.23 173.3 571.5 173.3 446.61 290.95 349.78 254.75 431.23 173.3"></polygon><polygon points="431.22 426.7 571.5 426.7 446.61 309.05 349.78 345.25 431.22 426.7"></polygon><polygon points="168.78 173.3 28.5 173.3 152.48 290.95 250.22 254.75 168.78 173.3"></polygon><polygon points="168.77 426.7 28.5 426.7 152.48 309.05 250.22 345.25 168.77 426.7"></polygon></svg>
    <div class="ismos-frontpage-column ismos-hero__grid{{^hasnext}} ismos-hero__grid--single{{/hasnext}}">
        <div class="ismos-hero__copy">
            <p class="ismos-hero__label">{{label}}</p>
            <h1 id="ismos-hero-title" class="ismos-hero__title">{{title}}{{#hastitleem}} <em>{{titleem}}</em>{{/hastitleem}}</h1>
            <p class="ismos-hero__lead">{{lead}}</p>
            <div class="ismos-hero__actions">
                {{#signupurl}}
                    <a class="ismos-hero__btn ismos-hero__btn--primary" href="{{{signupurl}}}">{{signup}}</a>
                {{/signupurl}}
                <a class="ismos-hero__btn ismos-hero__btn--ghost" href="{{{ctaurl}}}">{{cta}}</a>
            </div>
        </div>
        {{#hasnext}}
            {{#next}}
                <aside class="ismos-next" aria-labelledby="ismos-next-title">
                    <p class="ismos-next__when"><span>{{#str}}nextcohort, theme_ismos{{/str}}</span><span>{{startslabel}}</span></p>
                    <h2 id="ismos-next-title" class="ismos-next__title">{{name}}</h2>
                    {{#hassummary}}<p class="ismos-next__text">{{summary}}</p>{{/hassummary}}
                    <p class="ismos-next__meta">
                        <span>{{category}}</span>{{#enrolled}}<span aria-hidden="true">·</span><span>{{.}}</span>{{/enrolled}}{{#code}}<span aria-hidden="true">·</span><span>{{.}}</span>{{/code}}
                    </p>
                    <a class="ismos-next__btn" href="{{{url}}}">{{#str}}enrolbutton, theme_ismos{{/str}}</a>
                </aside>
            {{/next}}
        {{/hasnext}}
    </div>
</section>
{{/hero}}
<section class="ismos-facts" aria-label="{{#str}}facts, theme_ismos{{/str}}">
    <dl class="ismos-facts__list ismos-frontpage-column">
        {{#facts}}
            <div class="ismos-facts__item"><dt>{{value}}</dt><dd>{{label}}</dd></div>
        {{/facts}}
    </dl>
</section>
{{#haspaths}}
<section class="ismos-landing-sec" aria-labelledby="ismos-paths-title">
    <div class="ismos-frontpage-column">
        <span class="ismos-label">{{#str}}pathslabel, theme_ismos{{/str}}</span>
        <h2 id="ismos-paths-title">{{#str}}pathsheading, theme_ismos{{/str}}</h2>
        <ul class="ismos-paths">
            {{#paths}}
                <li class="ismos-path">
                    {{#haslevel}}
                        <span class="ismos-path__level" aria-hidden="true">{{#level}}<i{{#on}} class="on"{{/on}}></i>{{/level}}</span>
                        <span class="ismos-label ismos-path__kicker">{{kicker}}</span>
                    {{/haslevel}}
                    <h3>{{name}}</h3>
                    {{#hasdescription}}<p>{{description}}</p>{{/hasdescription}}
                    {{#hascourses}}
                        <ul class="ismos-path__courses">
                            {{#courses}}<li><a href="{{{url}}}">{{name}}</a></li>{{/courses}}
                        </ul>
                    {{/hascourses}}
                    <a class="ismos-path__more" href="{{{url}}}">{{#str}}pathlink, theme_ismos{{/str}}</a>
                </li>
            {{/paths}}
        </ul>
    </div>
</section>
{{/haspaths}}
{{#hascalendar}}
<section class="ismos-landing-sec ismos-landing-sec--flush" aria-labelledby="ismos-calendar-title">
    <div class="ismos-frontpage-column">
        <span class="ismos-label">{{#str}}calendarlabel, theme_ismos{{/str}}</span>
        <h2 id="ismos-calendar-title">{{#str}}calendarheading, theme_ismos{{/str}}</h2>
        <ul class="ismos-cal">
            {{#calendar}}
                <li class="ismos-cal__row">
                    <span class="ismos-cal__date">{{day}} {{month}}<small>{{year}}</small></span>
                    <a class="ismos-cal__name" href="{{{url}}}">{{name}}</a>
                    <span class="ismos-cal__cat">{{category}}</span>
                    <span class="ismos-cal__lang">{{#hascode}}<span class="ismos-chip">{{code}}</span>{{/hascode}}</span>
                    <a class="ismos-cal__enrol" href="{{{url}}}">{{#str}}enrollink, theme_ismos{{/str}}</a>
                </li>
            {{/calendar}}
        </ul>
    </div>
</section>
{{/hascalendar}}
<section class="ismos-landing-sec ismos-landing-sec--flush" aria-labelledby="ismos-how-title">
    <div class="ismos-frontpage-column">
        <span class="ismos-label">{{#str}}howlabel, theme_ismos{{/str}}</span>
        <h2 id="ismos-how-title">{{#str}}howheading, theme_ismos{{/str}}</h2>
        <ol class="ismos-steps">
            {{#steps}}
                <li class="ismos-step">
                    <div class="ismos-step__pane" aria-hidden="true">
                        {{#form}}
                            <div class="ismos-ill-form">
                                <span class="ismos-ill-form__title">{{#str}}signupheading, theme_ismos{{/str}}</span>
                                <span class="ismos-ill-form__input"></span><span class="ismos-ill-form__input"></span>
                                <span class="ismos-ill-form__submit"></span>
                                <span class="ismos-ill-form__provider"><i style="background: #662482"></i>Nostr</span>
                                <span class="ismos-ill-form__provider"><i style="background: #000"></i>GitHub</span>
                                <span class="ismos-ill-form__provider"><i style="background: linear-gradient(90deg, #4285f4, #ea4335, #fbbc05, #34a853)"></i>Google</span>
                            </div>
                        {{/form}}
                        {{#room}}
                            <div class="ismos-ill-room">
                                <div class="ismos-ill-room__side">
                                    <span class="ismos-ill-room__bar"></span>
                                    <span class="ismos-ill-room__bubble">{{#str}}howchat1, theme_ismos{{/str}}</span>
                                    <span class="ismos-ill-room__bubble">{{#str}}howchat2, theme_ismos{{/str}}</span>
                                </div>
                                <div class="ismos-ill-room__stage">
                                    <div class="ismos-ill-room__slide">
                                        <span class="ismos-ill-room__welcome">{{#str}}howwelcome, theme_ismos{{/str}}</span>
                                        <span class="ismos-ill-room__lines"><i style="inline-size: 70%"></i><i></i><i style="inline-size: 85%"></i><i style="inline-size: 55%"></i></span>
                                    </div>
                                    <span class="ismos-ill-room__buttons"><i></i><i></i><i class="on"></i><i></i></span>
                                </div>
                            </div>
                        {{/room}}
                        {{#cert}}
                            <div class="ismos-ill-cert">
                                <span class="ismos-ill-cert__head"><svg class="ismos-ill-cert__mark" aria-hidden="true" focusable="false" viewBox="0 0 600 600" fill="currentColor"><polygon points="426.7 431.22 426.7 571.5 309.05 447.51 345.25 349.77 426.7 431.22"></polygon><polygon points="173.3 431.22 173.3 571.5 290.95 447.51 254.75 349.77 173.3 431.22"></polygon><polygon points="426.7 168.77 426.7 28.5 309.05 152.48 345.25 250.22 426.7 168.77"></polygon><polygon points="173.3 168.77 173.3 28.5 290.95 152.48 254.75 250.22 173.3 168.77"></polygon><polygon points="431.23 173.3 571.5 173.3 446.61 290.95 349.78 254.75 431.23 173.3"></polygon><polygon points="431.22 426.7 571.5 426.7 446.61 309.05 349.78 345.25 431.22 426.7"></polygon><polygon points="168.78 173.3 28.5 173.3 152.48 290.95 250.22 254.75 168.78 173.3"></polygon><polygon points="168.77 426.7 28.5 426.7 152.48 309.05 250.22 345.25 168.77 426.7"></polygon></svg>{{#str}}wordmark, theme_ismos{{/str}}</span>
                                <span class="ismos-ill-cert__lines"><i></i><i></i><i></i></span>
                                <span class="ismos-ill-cert__foot"><span class="ismos-ill-cert__sign"></span><span class="ismos-ill-cert__seal"><svg class="ismos-ill-cert__sealmark" aria-hidden="true" focusable="false" viewBox="0 0 600 600" fill="currentColor"><polygon points="426.7 431.22 426.7 571.5 309.05 447.51 345.25 349.77 426.7 431.22"></polygon><polygon points="173.3 431.22 173.3 571.5 290.95 447.51 254.75 349.77 173.3 431.22"></polygon><polygon points="426.7 168.77 426.7 28.5 309.05 152.48 345.25 250.22 426.7 168.77"></polygon><polygon points="173.3 168.77 173.3 28.5 290.95 152.48 254.75 250.22 173.3 168.77"></polygon><polygon points="431.23 173.3 571.5 173.3 446.61 290.95 349.78 254.75 431.23 173.3"></polygon><polygon points="431.22 426.7 571.5 426.7 446.61 309.05 349.78 345.25 431.22 426.7"></polygon><polygon points="168.78 173.3 28.5 173.3 152.48 290.95 250.22 254.75 168.78 173.3"></polygon><polygon points="168.77 426.7 28.5 426.7 152.48 309.05 250.22 345.25 168.77 426.7"></polygon></svg></span></span>
                            </div>
                        {{/cert}}
                    </div>
                    <h3><span class="ismos-step__n">{{number}}</span>{{title}}</h3>
                    <p>{{text}}</p>
                </li>
            {{/steps}}
        </ol>
    </div>
</section>
{{#hasextra}}
<div class="ismos-frontpage-column ismos-frontpage-courses">
    {{{section1}}}
    {{{content}}}
</div>
{{/hasextra}}
{{#hastestimonials}}
<section class="ismos-landing-sec ismos-landing-sec--flush" aria-labelledby="ismos-testimonials-title">
    <div class="ismos-frontpage-column">
        <span class="ismos-label">{{#str}}testimonials, theme_ismos{{/str}}</span>
        <h2 id="ismos-testimonials-title">{{#str}}testimonialsheading, theme_ismos{{/str}}</h2>
        <ul class="ismos-quotes">
            {{#testimonials}}
                <li>
                    <figure class="ismos-quote">
                        <blockquote><p>{{quote}}</p></blockquote>
                        <figcaption>{{name}}</figcaption>
                    </figure>
                </li>
            {{/testimonials}}
        </ul>
    </div>
</section>
{{/hastestimonials}}
{{#final}}
<section class="ismos-final" aria-labelledby="ismos-final-title">
    <div class="ismos-frontpage-column ismos-final__inner">
        <h2 id="ismos-final-title">{{heading}}</h2>
        <a class="ismos-final__btn" href="{{{url}}}">{{cta}}</a>
    </div>
</section>
{{/final}}
