{{!
    @template core_course/coursecard

    ISMOS course card for the course overview block, the same card as the catalogue: a 16:9 picture (the mark when the
    course has none; Moodle's generated pattern is a data URI that theme CSS hides), the category as a mono kicker,
    the name, then the progress and the actions menu. Every region and data attribute of core is kept.

    Context variables required for this template:
    * id, viewurl, courseimage, fullname, shortname, showshortname, visible, uniqid

    Example context (json):
    {
        "courses": [
            {
                "name": "Assignment due 1",
                "viewurl": "https://moodlesite/course/view.php?id=2",
                "courseimage": "https://moodlesite/pluginfile/123/course/overviewfiles/123.jpg",
                "fullname": "course 3",
                "hasprogress": true,
                "progress": 10,
                "visible": true
            }
        ]
    }
}}
<div class="card course-card ismos-ccard" role="listitem"
    data-region="course-content"
    data-course-id="{{{id}}}">
    <a href="{{viewurl}}" tabindex="-1" class="ismos-ccard__imagelink">
        <span class="ismos-ccard__image" aria-hidden="true">
            {{> theme_ismos/ccard_mark}}
            <span class="ismos-ccard__photo" style='background-image: url("{{{courseimage}}}");'></span>
        </span>
        <span class="visually-hidden">{{fullname}}</span>
    </a>
    <div class="ismos-ccard__body course-info-container" id="course-info-container-{{id}}-{{uniqid}}">
        <div class="ismos-ccard__category">
            {{$coursecategory}}{{/coursecategory}}
        </div>
        {{#showshortname}}
            <div class="ismos-ccard__category">
                <span class="visually-hidden">
                    {{#str}}aria:courseshortname, core_course{{/str}}
                </span>
                {{{shortname}}}
            </div>
        {{/showshortname}}
        <a href="{{viewurl}}" class="aalink coursename ismos-ccard__title">
            {{> core_course/favouriteicon }}
            <span class="visually-hidden">
                {{#str}}aria:coursename, core_course{{/str}}
            </span>
            {{$coursename}}{{/coursename}}
        </a>
        {{^visible}}
            <span class="ismos-chip ismos-ccard__hidden">{{#str}} hiddenfromstudents {{/str}}</span>
        {{/visible}}
        <div class="ismos-ccard__foot">
            {{$progress}}{{/progress}}
            {{$menu}}{{/menu}}
        </div>
    </div>
</div>
