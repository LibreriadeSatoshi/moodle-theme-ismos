{{!
    @template core_course/coursecard

    ISMOS course card for the course overview block: a 6 x 32 px bar, the category as a mono label, the course
    name, then the progress and the actions menu. The cover only shows for a real course image; Moodle's
    generated pattern (a data URI) is hidden by theme CSS. Every region and data attribute of core is kept.

    Context variables required for this template:
    * id, viewurl, courseimage, fullname, shortname, showshortname, visible, uniqid

    Example context (json):
    {
        "courses": [
            {
                "name": "Assignment due 1",
                "viewurl": "https://moodlesite/course/view.php?id=2",
                "courseimage": "https://moodlesite/pluginfile/123/course/overviewfiles/123.jpg",
                "fullname": "course 3",
                "hasprogress": true,
                "progress": 10,
                "visible": true
            }
        ]
    }
}}
<div class="card course-card ismos-course-card" role="listitem"
    data-region="course-content"
    data-course-id="{{{id}}}">
    <a href="{{viewurl}}" tabindex="-1" class="ismos-course-card__cover">
        <div class="card-img-top" style='background-image: url("{{{courseimage}}}");'>
            <span class="visually-hidden">{{fullname}}</span>
        </div>
    </a>
    <div class="card-body course-info-container" id="course-info-container-{{id}}-{{uniqid}}">
        <span class="ismos-course-card__bar" aria-hidden="true"></span>
        <div class="ismos-course-card__category">
            {{$coursecategory}}{{/coursecategory}}
        </div>
        {{#showshortname}}
            <div class="ismos-course-card__shortname">
                <span class="visually-hidden">
                    {{#str}}aria:courseshortname, core_course{{/str}}
                </span>
                {{{shortname}}}
            </div>
        {{/showshortname}}
        <a href="{{viewurl}}" class="aalink coursename ismos-course-card__name">
            {{> core_course/favouriteicon }}
            <span class="visually-hidden">
                {{#str}}aria:coursename, core_course{{/str}}
            </span>
            {{$coursename}}{{/coursename}}
        </a>
        {{^visible}}
            <div class="d-flex flex-wrap">
                <span class="badge bg-info text-white">{{#str}} hiddenfromstudents {{/str}}</span>
            </div>
        {{/visible}}
    </div>
    <div class="ismos-course-card__foot d-flex align-items-center">
        {{$progress}}{{/progress}}
        {{$menu}}{{/menu}}
    </div>
</div>
