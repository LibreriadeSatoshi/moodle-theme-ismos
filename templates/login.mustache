{{!
    @template theme_ismos/login

    ISMOS login and signup page: Mauveine block (mark, wordmark, line) and the form column.

    Context variables required for this template:
    * output - The core renderer for the page
    * bodyattributes - attributes for the body tag
    * output.standard_footer_html - site policies link and other footer output, shown as a quiet strip under the form
    * line, haslead, lead, address, wordmark - text of the block
    * issignup - the signup page, whose form column starts with its heading, the "Already have an account?" line,
      the sign-in buttons (identityproviders, nostr) and an "or with your email" divider (loginurl, hasidentityproviders)

    Example context (json):
    {
        "output": {
            "doctype": "<!DOCTYPE html>",
            "page_title": "Login page",
            "favicon": "favicon.ico",
            "main_content": "<h1>Log in</h1>"
        },
        "bodyattributes": "",
        "line": "Welcome back. Pick up where you left off.",
        "haslead": false,
        "lead": "",
        "address": "ISMOS.XYZ",
        "wordmark": "ISMOS"
    }
}}
{{> theme_boost/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}

<div id="page-wrapper" class="ismos-login-page">

    {{{ output.standard_top_of_body_html }}}

    <div class="ismos-login">
        <div class="ismos-login__block">
            <div class="ismos-login__block-inner">
                <a class="ismos-login__brand" href="{{{ config.homeurl }}}">
                    <img src="{{{ output.get_ismos_mark_url }}}" width="32" height="32" alt="" aria-hidden="true">
                    <span>{{wordmark}}</span>
                </a>
                <div class="ismos-login__message">
                    <p class="ismos-login__line">{{line}}</p>
                    {{#haslead}}
                        <p class="ismos-login__lead">{{lead}}</p>
                    {{/haslead}}
                </div>
                <p class="ismos-login__address">{{address}}</p>
            </div>
        </div>
        <div class="ismos-login__side">
            <div id="page-content" class="ismos-login__form">
                <div id="region-main-box">
                    <div id="region-main">
                        <div class="login-wrapper">
                            <div class="login-container">
                                {{#issignup}}
                                    <div class="ismos-signup-head">
                                        <h1 class="login-heading">{{#str}} signupheading, theme_ismos {{/str}}</h1>
                                        <p class="ismos-login-alt">
                                            {{#str}} alreadyhaveaccount, theme_ismos {{/str}}
                                            <a href="{{loginurl}}">{{#str}} loginlink, theme_ismos {{/str}}</a>
                                        </p>
                                        {{#hasidentityproviders}}
                                            <div class="ismos-idps">
                                                <h2 class="visually-hidden">{{#str}} potentialidps, auth {{/str}}</h2>
                                                {{#identityproviders}}
                                                    <a class="btn login-identityprovider-btn{{#primary}} ismos-idp-primary{{/primary}}" href="{{url}}"{{^primary}} title="{{label}}"{{/primary}}>
                                                        {{#iconurl}}<img src="{{iconurl}}" alt="" width="20" height="20">{{/iconurl}}
                                                        {{#primary}}{{label}}{{/primary}}
                                                        {{^primary}}<span class="visually-hidden">{{label}}</span>{{/primary}}
                                                    </a>
                                                {{/identityproviders}}
                                                {{#nostr}}
                                                    <a class="btn login-identityprovider-btn" href="{{url}}" title="{{label}}">
                                                        <img src="{{iconurl}}" alt="" width="20" height="20">
                                                        <span class="visually-hidden">{{label}}</span>
                                                    </a>
                                                {{/nostr}}
                                            </div>
                                            <div class="login-divider-or ismos-login-or">{{#str}} loginwithemail, theme_ismos {{/str}}</div>
                                        {{/hasidentityproviders}}
                                    </div>
                                {{/issignup}}
                                {{{ output.main_content }}}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <footer class="ismos-login__footer" data-region="footer-content">
                {{#output.has_popover_links}}
                    {{#output.page_doc_link}}<div>{{{ output.page_doc_link }}}</div>{{/output.page_doc_link}}
                    {{#output.services_support_link}}<div>{{{ output.services_support_link }}}</div>{{/output.services_support_link}}
                    {{#output.supportemail}}<div>{{{ output.supportemail }}}</div>{{/output.supportemail}}
                {{/output.has_popover_links}}
                {{{ output.standard_footer_html }}}
                {{{ output.debug_footer_html }}}
            </footer>
        </div>
    </div>
    {{{ output.standard_after_main_region_html }}}
    {{{ output.standard_end_of_body_html }}}
</div>

</body>
</html>
{{#js}}
{{!
    Show/hide password on every password field of these pages. Unlike core/togglesensitive, the field is moved into
    the wrapper, never re-rendered, so what was already typed or autofilled is kept.
}}
(function() {
    var show = {{#quote}}{{#str}} showpassword, theme_ismos {{/str}}{{/quote}};
    var hide = {{#quote}}{{#str}} hidepassword, theme_ismos {{/str}}{{/quote}};
    var showShort = {{#quote}}{{#str}} showshort, theme_ismos {{/str}}{{/quote}};
    var hideShort = {{#quote}}{{#str}} hideshort, theme_ismos {{/str}}{{/quote}};
    document.querySelectorAll('.ismos-login__form input[type="password"]').forEach(function(input) {
        if (!input.id || input.closest('.toggle-sensitive-wrapper')) {
            return;
        }
        var wrapper = document.createElement('div');
        wrapper.className = 'toggle-sensitive-wrapper';
        input.parentNode.insertBefore(wrapper, input);
        wrapper.appendChild(input);
        var button = document.createElement('button');
        button.type = 'button';
        button.className = 'toggle-sensitive-btn btn';
        button.setAttribute('aria-controls', input.id);
        button.setAttribute('aria-label', show);
        button.textContent = showShort;
        button.addEventListener('click', function() {
            var reveal = input.type === 'password';
            input.type = reveal ? 'text' : 'password';
            button.setAttribute('aria-label', reveal ? hide : show);
            button.textContent = reveal ? hideShort : showShort;
        });
        wrapper.appendChild(button);
    });
})();
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader'], function() {
  M.util.js_complete('theme_boost/loader');
});
{{/js}}
