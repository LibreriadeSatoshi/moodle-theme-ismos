{{!
    @template enrol_fee/enrol_page

    Contents of the enrolment widget on the course enrolment page (theme_ismos). Shows the
    gateway's logo when the instance has exactly one gateway configured (see enrol_fee plugin.php).

    Example context (json):
    {
        "cost": "10.00",
        "gateway": {"shortname": "btcpay", "name": "BTCPay Server", "showname": true, "wordmark": false}
    }
}}
<div class="ismos-enrolfee">
    <div class="ismos-enrolfee__cost">
        {{#str}} labelvalue, core, {"label": {{#quote}}{{#str}} cost {{/str}}{{/quote}}, "value": {{#quote}}{{cost}}{{/quote}} }{{/str}}
    </div>
    {{#gateway}}
    <div class="ismos-enrolfee__gateway">
        <span class="paygw-icon-badge{{#wordmark}} paygw-icon-badge--wordmark{{/wordmark}}">
            {{#pix}} img, paygw_{{shortname}} {{/pix}}
        </span>
        {{#showname}}
        <span class="ismos-enrolfee__gatewayname">{{name}}</span>
        {{/showname}}
    </div>
    {{/gateway}}
</div>
