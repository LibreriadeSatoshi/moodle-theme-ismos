{{!
    @template theme_boost/footer

    ISMOS override: Ink footer (the optional footermark context value is the mark URL for layouts whose output is not the theme
    renderer, such as maintenance) with the mark, address and language menu. The help links, login info and
    standard footer output are shown inline instead of in Boost's popover.

    Page footer.

    Example context (json):
    {
        "output": {
            "page_doc_link": "Documentation for this page",
            "supportemail": "<a href=\"#\">Contact site support</a>",
            "has_popover_links": true,
            "services_support": "Services and support",
            "login_info": "You are logged in as cute kitten",
            "moodle_release": "90210",
            "has_communication_links": true,
            "communication_url": "https://element:8081/#/room/#yourroom:synapse",
            "communication_link": "<a href=\"#\">Communication room</a>"
        }
    }
}}

<footer id="page-footer" class="ismos-footer">
    <div class="ismos-footer-inner">
        <div class="ismos-footer-brand">
            <img src="{{#footermark}}{{{ . }}}{{/footermark}}{{^footermark}}{{{ output.get_ismos_mark_url }}}{{/footermark}}" class="ismos-mark" width="20" height="20" alt="" aria-hidden="true">
            <span class="ismos-footer-address">{{#str}}address, theme_ismos{{/str}}</span>
        </div>
        <div class="ismos-footer-lang">
            {{{ output.lang_menu }}}
        </div>
    </div>
    <div class="ismos-footer-inner ismos-footer-links" data-region="footer-content">
        {{#output.has_communication_links}}
            <div class="footer-section footer-link-communication">
                <div class="footer-support-link">{{{ output.communication_link }}}</div>
            </div>
        {{/output.has_communication_links}}
        {{# output.has_popover_links }}
            <div class="footer-section">
                {{# output.page_doc_link }}
                    <div class="footer-support-link">{{{ output.page_doc_link }}}</div>
                {{/ output.page_doc_link }}

                {{# output.services_support_link }}
                    <div class="footer-support-link">{{{ output.services_support_link }}}</div>
                {{/ output.services_support_link }}

                {{# output.supportemail }}
                    <div class="footer-support-link">{{{ output.supportemail }}}</div>
                {{/ output.supportemail }}
            </div>
        {{/ output.has_popover_links }}
        <div class="footer-section">
            <div class="logininfo">
                {{{ output.login_info }}}
            </div>
            <div class="tool_usertours-resettourcontainer">
            </div>

            {{{ output.standard_footer_html }}}
            {{{ output.standard_end_of_body_html }}}
        </div>
        <div class="footer-section">
            <div>{{#str}}poweredbymoodle, core{{/str}}</div>
            {{#output.moodle_release}}
                <div>
                    {{#str}}version, core{{/str}} {{{ output.moodle_release }}}
                </div>
            {{/output.moodle_release}}
        </div>
    </div>

    <div class="footer-content-debugging footer-dark bg-dark text-light">
        <div class="container-fluid footer-dark-inner">
            {{{ output.debug_footer_html }}}
        </div>
    </div>
</footer>
