{{!
    @template theme_ismos/frontpage

    ISMOS front page shell: top bar, main region, footer. No course index or block drawers.
    The hero, category browse row, course list and testimonials are the main content, rendered by
    theme_ismos\output\core\course_renderer::frontpage() with theme_ismos/frontpage_main, so they sit inside the main
    landmark and after the skip link target.

    Context variables required for this template:
    * output - The core renderer for the page
    * bodyattributes - attributes for the body tag

    Example context (json):
    {
        "output": {
            "doctype": "<!DOCTYPE html>",
            "page_title": "ISMOS",
            "favicon": "favicon.ico",
            "main_content": "<div class='courses'></div>"
        },
        "bodyattributes": "",
        "hasheaderactions": false
    }
}}
{{> theme_boost/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}
<div id="page-wrapper" class="d-print-block">

    {{{ output.standard_top_of_body_html }}}

    {{> theme_boost/navbar }}
    <div id="page" data-region="mainpage" data-usertour="scroller" class="drawers drag-container">
        <div id="topofscroll" class="main-inner">
            {{#hasheaderactions}}
                <div class="ismos-frontpage-actions d-print-none">{{{ headeractions }}}</div>
            {{/hasheaderactions}}
            {{#secondarymoremenu}}
                <div class="secondary-navigation d-print-none">
                    {{> core/moremenu}}
                </div>
            {{/secondarymoremenu}}
            <div id="page-content" class="pb-3 d-print-block">
                <div id="region-main-box">
                    <div id="region-main">
                        {{#overflow}}
                            <div class="container-fluid tertiary-navigation">
                                <div class="navitem">
                                    {{> core/url_select}}
                                </div>
                            </div>
                        {{/overflow}}
                        {{{ output.course_content_header }}}
                        {{{ output.main_content }}}
                        {{{ output.course_content_footer }}}
                    </div>
                </div>
            </div>
        </div>
        {{> theme_boost/footer }}
    </div>
    {{{ output.standard_after_main_region_html }}}
</div>

</body>
</html>
{{#js}}
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader', 'theme_boost/drawer'], function(Loader, Drawer) {
    Drawer.init();
    M.util.js_complete('theme_boost/loader');
});
{{/js}}
