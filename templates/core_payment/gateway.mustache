{{!
    @template core_payment/gateway

    A gateway option in the gateway selector modal (theme_ismos). Same radio name, value, id and
    data attributes as core's template; the look lives in scss/ismos/_payment.scss.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * data-cost, data-surcharge on the radio

    Context variables required for this template:
    * shortname
    * name
    * description
    * surcharge
    * cost
    * uniqid
    * checked

    Example context (json):
    {
        "shortname": "paypal",
        "name": "PayPal",
        "description": "A description for PayPal.",
        "surcharge": "3",
        "cost": "10.00",
        "uniqid": "abc123",
        "checked": true
    }

}}
<div class="ismos-gateway {{shortname}}">
    <input class="form-check-input ismos-gateway__radio" type="radio" name="payby" id="id-payby-{{uniqid}}-{{shortname}}" data-cost="{{cost}}" data-surcharge="{{surcharge}}" value="{{shortname}}" {{#checked}} checked="checked" {{/checked}} />
    <label class="ismos-gateway__label" for="id-payby-{{uniqid}}-{{shortname}}">
        <span class="ismos-gateway__head">
            <span class="paygw-icon-badge paygw-icon-badge--option">
                {{#pix}} img, paygw_{{shortname}} {{/pix}}
            </span>
            <span class="ismos-gateway__name">{{name}}</span>
        </span>
        <span class="ismos-gateway__description">{{{description}}}</span>
    </label>
</div>
