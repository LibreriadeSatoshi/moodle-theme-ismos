{{!
    @template theme_ismos/core/email_html

    ISMOS template for all html emails: 600 px, one column, Ink and white only.
    Styles are inline because email clients drop external CSS; the style block
    is progressive enhancement only.

    Context variables required for this template:
    * sitefullname
    * siteshortname
    * sitewwwroot
    * subject
    * to
    * toname
    * touserid
    * tousername
    * from
    * fromname
    * replyto
    * replytoname
    * body
    * prefix

    Example context (json):
    {
        "prefix": "[Prefix Text]",
        "sitefullname": "ISMOS",
        "siteshortname": "ISMOS",
        "sitewwwroot": "https://ismos.xyz",
        "body": "<p>Email body</p>"
    }
}}
<style>
    .ismos-email-body a { color: #4d01e0; text-decoration: underline; }
    @media only screen and (max-width: 620px) {
        .ismos-email-wrap { width: 100% !important; }
    }
</style>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;background-color:#ffffff;margin:0;padding:0;">
    <tr>
        <td align="center" style="padding:24px 16px;">
            <table role="presentation" class="ismos-email-wrap" width="600" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:600px;background-color:#ffffff;">
                <tr>
                    <td style="padding:0 0 16px 0;border-bottom:1px solid #dfd8fb;font-family:'IBM Plex Sans',Georgia,system-ui,sans-serif;">
                        <a href="{{{sitewwwroot}}}" style="color:#000000;text-decoration:none;">
                            <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                                <tr>
                                    <td valign="middle" style="padding:0 8px 0 0;line-height:0;">
                                        <img src="{{{sitewwwroot}}}/theme/ismos/pix/email-logo.png" width="18" height="18" alt="ISMOS" style="display:block;border:0;width:18px;height:18px;">
                                    </td>
                                    <td valign="middle" style="font-family:'IBM Plex Sans',Georgia,system-ui,sans-serif;font-size:15px;line-height:24px;font-weight:bold;letter-spacing:0.02em;color:#000000;">ISMOS</td>
                                </tr>
                            </table>
                        </a>
                    </td>
                </tr>
                <tr>
                    <td class="ismos-email-body" style="padding:24px 0;font-family:'IBM Plex Sans',Georgia,system-ui,sans-serif;font-size:17px;line-height:28px;color:#000000;background-color:#ffffff;">
                        {{{body}}}
                    </td>
                </tr>
                <tr>
                    <td style="padding:16px 0 0 0;border-top:1px solid #dfd8fb;font-family:'IBM Plex Mono',ui-monospace,Menlo,Consolas,monospace;font-size:13px;line-height:20px;color:#000000;">
                        {{sitefullname}}<br>
                        {{#str}}address, theme_ismos{{/str}}
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
