{{!
    @template core/signup_form_layout

    ISMOS override: only the form. The heading ("Create your account"), the log-in link and the sign-in buttons
    are drawn by the theme's login layout above it, so core's "New account" heading and logo are not shown.

    Example context (json):
    {
        "logourl": "https://moodle.org/logo/moodle-logo.svg",
        "sitename": "Site name",
        "formhtml": "<p>(Form html would go here)</p>"
    }
}}
<div class="signupform">
    {{! The heading, the log-in link and the sign-in buttons are in the theme's login layout, above the form. }}
    {{{formhtml}}}
</div>
