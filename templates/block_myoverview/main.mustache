{{!
    @template block_myoverview/main

    ISMOS override of the main area of the course overview block, in the catalogue's style: the grouping as tabs and the
    search on one line, then the sort and view dropdowns. Every region, data attribute and action the block's JavaScript
    uses is kept: the filter region holds all three selectors, so grouping, sort and view still drive the courses view.

    Example context (json):
    {}
}}
<div id="block-myoverview-{{uniqid}}" class="block-myoverview block-cards" data-region="myoverview">
    <div role="search" data-region="filter" class="ismos-mc" aria-label="{{#str}} aria:controls, block_myoverview {{/str}}">
        <div class="ismos-catalogue__tools ismos-mc__tools">
            {{> block_myoverview/nav-grouping-selector }}

            {{!
                Override the `searchrole` block with an empty string to remove the `role="search"` landmark in
                `core/search_input_auto` used by the `block_myoverview/nav-search-widget` template.
                It is not necessary for the Course overview block that already has its own search landmark.
            }}
            {{< block_myoverview/nav-search-widget }}
                {{$searchrole}}{{/searchrole}}
            {{/ block_myoverview/nav-search-widget }}
        </div>
        <div class="ismos-mc__views">
            {{> block_myoverview/nav-sort-selector }}
            {{#displaydropdown}}
                {{> block_myoverview/nav-display-selector }}
            {{/displaydropdown}}
        </div>
    </div>

    <div class="container-fluid p-0">
        {{> block_myoverview/courses-view }}
    </div>
</div>
{{#js}}
require(
[
    'jquery',
    'block_myoverview/main',
],
function(
    $,
    Main
) {
    var root = $('#block-myoverview-{{uniqid}}');
    Main.init(root);
});
{{/js}}
