{{!
    @template theme_ismos/maintenance

    ISMOS maintenance layout: the mark and wordmark at the top, then the heading and the maintenance message.
    This layout runs when the database is not available, so the mark uses direct static URLs (theme/image.php
    is not reachable) and nothing here may call the database.

    Context variables required for this template:
    * output - The core renderer for the page
    * markink - URL of the Ink mark
    * markpaper - URL of the Paper mark
    * homeurl - URL of the site
    * wordmark - The wordmark text

    Example context (json):
    {
        "output": {
            "doctype": "<!DOCTYPE html>",
            "page_title": "Test page",
            "favicon": "favicon.ico",
            "main_content": "<h1>Site maintenance</h1>"
        },
        "markink": "/theme/ismos/pix/ismos-mark-ink.svg",
        "markpaper": "/theme/ismos/pix/ismos-mark-paper.svg",
        "homeurl": "/",
        "wordmark": "ISMOS"
    }
}}
{{{ output.doctype }}}
<html {{{ output.htmlattributes }}}>
<head>
    <title>{{{ output.page_title }}}</title>
    <link rel="shortcut icon" href="{{{ output.favicon }}}" />
    {{{ output.standard_head_html }}}
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>

<body {{{ output.body_attributes }}}>
{{> core/local/toast/wrapper}}

<div id="page-wrapper" class="ismos-maintenance">

    {{{ output.standard_top_of_body_html }}}

    <header class="ismos-maintenance__bar">
        <a href="{{{ homeurl }}}" class="ismos-wordmark ismos-maintenance__brand d-flex align-items-center">
            <img src="{{{ markink }}}" class="ismos-mark ismos-mark-ink" width="20" height="20" alt="" aria-hidden="true">
            <img src="{{{ markpaper }}}" class="ismos-mark ismos-mark-paper" width="20" height="20" alt="" aria-hidden="true">
            <span class="ismos-wordmark-text">{{ wordmark }}</span>
        </a>
    </header>

    <div id="page" class="ismos-maintenance__page">
        <div id="page-content">
            <div id="region-main">
                {{{ output.main_content }}}
            </div>
        </div>
    </div>
    {{> theme_boost/footer }}
</div>

</body>
</html>
{{#js}}
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader'], function() {
  M.util.js_complete('theme_boost/loader');
});
{{/js}}
