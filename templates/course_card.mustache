{{!
    @template theme_ismos/course_card

    ISMOS course card. The whole card is one link; it holds no other interactive element. The course cover, when there is one, is decorative.

    Context variables required for this template:
    * id - Course id
    * uid - Unique id prefix for this render
    * hidden - Whether the course is hidden from students
    * hiddenlabel - Text for the hidden marker
    * url - Course URL
    * title - Formatted course name
    * image - Optional cover: url, width, height, prioritise (eager and high fetch priority for the first on the page)
    * label - Category name
    * summary - Plain text summary
    * hasteachers - Whether there are teachers
    * teachers - Up to two teachers: name, pictureurl (may be null), initials
    * hasfacts - Whether there are facts
    * facts - Strings for the facts line

    Example context (json):
    {
        "id": 2,
        "uid": "ismos-card-2-abc",
        "hidden": true,
        "hiddenlabel": "Hidden from students",
        "url": "https://example.com/course/view.php?id=2",
        "title": "Running a Bitcoin node",
        "image": {"url": "https://example.com/cover.webp", "width": 800, "height": 450, "prioritise": false},
        "label": "Freedom tech",
        "summary": "Install, sync and secure a full node on your own hardware.",
        "hasteachers": true,
        "teachers": [
            {"name": "Ada Lovelace", "pictureurl": "https://example.com/u/f1.jpg", "initials": "AL"},
            {"name": "Grace Hopper", "pictureurl": null, "initials": "GH"}
        ],
        "hasfacts": true,
        "facts": ["Starts Monday, 2 November 2026"]
    }
}}
<a class="ismos-card{{#hidden}} ismos-card--hidden{{/hidden}}" href="{{{url}}}" aria-labelledby="{{uid}}-title{{#hidden}} {{uid}}-hidden{{/hidden}}"{{#summary}} aria-describedby="{{uid}}-text{{#hasfacts}} {{uid}}-facts{{/hasfacts}}"{{/summary}}{{^summary}}{{#hasfacts}} aria-describedby="{{uid}}-facts"{{/hasfacts}}{{/summary}}>
    {{#image}}<img class="ismos-card__cover" src="{{{url}}}" alt="" width="{{width}}" height="{{height}}" {{#prioritise}}loading="eager" fetchpriority="high"{{/prioritise}}{{^prioritise}}loading="lazy" decoding="async"{{/prioritise}}>{{/image}}
    <span class="ismos-card__bar" aria-hidden="true"></span>
    {{#label}}<span class="ismos-card__label">{{label}}</span>{{/label}}
    {{#hidden}}<span class="ismos-card__hidden" id="{{uid}}-hidden">{{hiddenlabel}}</span>{{/hidden}}
    <h3 class="ismos-card__title" id="{{uid}}-title">{{{title}}}</h3>
    {{#summary}}<p class="ismos-card__text" id="{{uid}}-text">{{summary}}</p>{{/summary}}
    {{#hasteachers}}
    <span class="ismos-card__teachers">
        {{#teachers}}
        <span class="ismos-card__teacher">
            {{#pictureurl}}<img class="ismos-avatar" src="{{{pictureurl}}}" alt="" width="32" height="32" loading="lazy">{{/pictureurl}}
            {{^pictureurl}}<span class="ismos-avatar ismos-avatar--initials" aria-hidden="true">{{initials}}</span>{{/pictureurl}}
            <span class="ismos-card__teacher-name">{{name}}</span>
        </span>
        {{/teachers}}
    </span>
    {{/hasteachers}}
    {{#hasfacts}}
    <span class="ismos-card__facts" id="{{uid}}-facts">
        {{#facts}}<span>{{.}}</span>{{/facts}}
    </span>
    {{/hasfacts}}
</a>
